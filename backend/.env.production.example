# ============================================================================
# Production — toàn bộ ứng dụng tự host trên 1 server (docker-compose.prod.yml).
#
# File thật: backend/.env.production — CHỈ nằm trên server (quyền 600), không
# commit. CI/CD không đụng tới file này: sửa tay trên server rồi deploy lại
# (Actions → CI/CD → Run workflow, hoặc `bash deploy/deploy.sh` trên server).
#
# Các biến đã ghép sẵn trong docker-compose.prod.yml, KHÔNG khai ở đây:
#   DATABASE_URL (từng service), USER_MONGO_URI, RABBITMQ_URL,
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (= tài khoản root MinIO)
# ============================================================================

NODE_ENV=production

# --- Địa chỉ công khai: một domain, mọi thứ đi qua nginx trên host ---
# (deploy/nginx/daln.conf)  / web | /api/ Kong | /socket.io/ socket | /daln-media/ MinIO
# VITE_* được build vào bundle: đổi xong phải deploy lại để image web build lại.
FRONTEND_URL=https://DOMAIN
VITE_API_ROOT=https://DOMAIN/api
VITE_SOCKET_URL=https://DOMAIN/realtime
# URL ký sẵn (presigned) ký theo host này -> phải đúng domain trình duyệt gọi.
S3_PUBLIC_ENDPOINT=https://DOMAIN
# Phải trùng tên bucket ở S3_BUCKET bên dưới.
CDN_PUBLIC_URL=https://DOMAIN/daln-media

# HTTPS -> cookie mang cờ Secure. Chỉ đặt =false khi chạy HTTP thuần (không có
# domain/chứng chỉ), nếu không trình duyệt bỏ cookie và không đăng nhập được.
COOKIE_SECURE=true

# --- Khoá bí mật (BẮT BUỘC) — sinh bằng: openssl rand -hex 32 ---
# Thiếu JWT_SECRET thì dịch vụ dừng ngay khi khởi động. Đổi nó = mọi người bị đăng xuất.
JWT_SECRET=
# Bảo vệ các endpoint @InternalOnly (train / evaluate / embed). Thiếu = chặn hết (403).
INTERNAL_API_TOKEN=

# --- RabbitMQ (container rabbitmq) ---
# Mật khẩu chỉ được áp dụng LÚC TẠO volume. Đổi về sau phải chạy thêm:
#   docker exec daln-prod-rabbitmq rabbitmqctl change_password <user> <pass>
# Chỉ dùng ký tự an toàn trong URL (chữ, số) vì nó được ghép vào RABBITMQ_URL.
RABBITMQ_DEFAULT_USER=daln
RABBITMQ_DEFAULT_PASS=

# --- MinIO (container minio) — cũng chính là khoá S3 của app ---
MINIO_ROOT_USER=daln-admin
# Tối thiểu 8 ký tự.
MINIO_ROOT_PASSWORD=
AWS_REGION=us-east-1
S3_BUCKET=daln-media
S3_ENDPOINT=http://minio:9000

# --- Hạ tầng nội bộ (tên service trong mạng docker) ---
REDIS_URL=redis://redis:6379
QDRANT_HOST=qdrant
QDRANT_PORT=6333
RECOMMENDATION_SERVICE_URL=http://recommendation:3005

# --- SMTP (Gmail: dùng App Password, không phải mật khẩu tài khoản) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- TURN (gọi thoại 1-1 qua coturn) ---
# coturn cài bằng apt TRÊN HOST (không trong Docker) — xem deploy/README.md (mục
# TURN) và deploy/deploy.sh. TURN_SECRET dùng CHUNG: gateway ký mật khẩu ngắn hạn
# (call.ice_config), coturn tự kiểm bằng chính nó (use-auth-secret). deploy.sh
# render /etc/turnserver.conf từ deploy/coturn/turnserver.conf, thay TURN_SECRET/
# TURN_REALM/TURN_HOST bằng các giá trị dưới đây. Đổi secret thì đổi ở ĐÂY rồi
# deploy lại (config render lại); mật khẩu cũ tự hết hạn trong 1 giờ.
#   openssl rand -hex 32
TURN_SECRET=
# turn:/stun: dùng THẲNG IP -> không phụ thuộc DNS (nameserver .xyz đang chập chờn).
TURN_HOST=109.199.115.126
# turns: (TLS) dùng TÊN MIỀN để khớp chứng chỉ Let's Encrypt dùng chung với nginx.
TURN_TLS_HOST=nguyen1976.xyz
# realm của coturn (đưa vào /etc/turnserver.conf khi render).
TURN_REALM=nguyen1976.xyz
# Hạn mật khẩu TURN (giây). Mặc định của gateway cũng là 3600.
TURN_TTL=3600
# Gateway hỏi chat service ai là người nhận hợp lệ của cuộc gọi 1-1 (call-peer).
# realtime-gateway nhận biến này qua env_file .env.production (docker-compose.prod.yml).
CHAT_SERVICE_URL=http://chat:3003

# --- LiveKit (gọi NHÓM audio qua SFU) ---
# livekit-server chạy TRONG docker (service `livekit`, docker-compose.prod.yml).
# WS đi qua nginx /livekit/ (deploy/nginx/daln.conf); media UDP 50000-50199 + RTC
# TCP 7881 ra thẳng ngoài — nhớ `ufw allow 50000:50199/udp` và `ufw allow 7881/tcp`
# (xem deploy/README.md, mục LiveKit).
#
# Quan hệ key/secret: compose truyền env LIVEKIT_KEYS="${LIVEKIT_API_KEY}: ${LIVEKIT_API_SECRET}"
# cho container livekit (nó nạp keys map từ env này). Gateway ký token bằng CHÍNH
# LIVEKIT_API_KEY/SECRET (livekit-server-sdk) và verify webhook bằng cặp đó, nên:
#   1) LIVEKIT_API_SECRET là secret THẬT (openssl rand -hex 32);
#   2) LIVEKIT_API_KEY là TÊN key và PHẢI TRÙNG `webhook.api_key` (daln) trong
#      deploy/livekit/livekit.prod.yaml — đổi tên thì đổi cả hai chỗ.
# client connect qua nginx: wss://<domain>/livekit (khớp FRONTEND_URL/domain ở trên).
LIVEKIT_URL=wss://nguyen1976.xyz/livekit
LIVEKIT_API_KEY=daln
LIVEKIT_API_SECRET=
