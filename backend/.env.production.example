# ============================================================================
# Production — toàn bộ ứng dụng tự host trên 1 server (docker-compose.prod.yml).
#
# File thật: backend/.env.production — CHỈ nằm trên server (quyền 600), không
# commit. CI/CD không đụng tới file này: sửa tay trên server rồi deploy lại
# (Actions → CI/CD → Run workflow, hoặc `bash deploy/deploy.sh` trên server).
#
# Các biến đã ghép sẵn trong docker-compose.prod.yml, KHÔNG khai ở đây:
#   DATABASE_URL (từng service), USER_MONGO_URI, RABBITMQ_URL,
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (= tài khoản root MinIO)
# ============================================================================

NODE_ENV=production

# --- Địa chỉ công khai: một domain, mọi thứ đi qua nginx trên host ---
# (deploy/nginx/daln.conf)  / web | /api/ Kong | /socket.io/ socket | /daln-media/ MinIO
# VITE_* được build vào bundle: đổi xong phải deploy lại để image web build lại.
FRONTEND_URL=https://DOMAIN
VITE_API_ROOT=https://DOMAIN/api
VITE_SOCKET_URL=https://DOMAIN/realtime
# URL ký sẵn (presigned) ký theo host này -> phải đúng domain trình duyệt gọi.
S3_PUBLIC_ENDPOINT=https://DOMAIN
# Phải trùng tên bucket ở S3_BUCKET bên dưới.
CDN_PUBLIC_URL=https://DOMAIN/daln-media

# HTTPS -> cookie mang cờ Secure. Chỉ đặt =false khi chạy HTTP thuần (không có
# domain/chứng chỉ), nếu không trình duyệt bỏ cookie và không đăng nhập được.
COOKIE_SECURE=true

# Đường dẫn của cookie refresh, PHẢI khớp với URL mà trình duyệt gọi — tức là
# tiền tố trong VITE_API_ROOT ở trên cộng thêm /user.
#
# nginx phục vụ API dưới /api/ rồi CẮT tiền tố đi, nên user-service chỉ thấy
# /user/refresh và không có cách nào tự đoán ra được tiền tố. Để trống ở đây là
# cookie mang Path=/user trong khi trình duyệt gọi /api/user/refresh: hai đường
# không khớp, cookie không bao giờ được gửi, và MỌI người dùng bị đăng xuất
# đúng 15 phút sau khi đăng nhập (lúc access cookie tự hết hạn). Dev không thấy
# vì ở đó frontend gọi thẳng Kong, không qua tiền tố nào.
#
# Đổi VITE_API_ROOT thì đổi luôn dòng này. Gọi API ở domain riêng
# (https://api.DOMAIN, không tiền tố) thì đặt /user.
REFRESH_COOKIE_PATH=/api/user

# --- Khoá bí mật (BẮT BUỘC) — sinh bằng: openssl rand -hex 32 ---
# Thiếu JWT_SECRET thì dịch vụ dừng ngay khi khởi động. Đổi nó = mọi người bị đăng xuất.
JWT_SECRET=
# Bảo vệ các endpoint @InternalOnly (train / evaluate / embed). Thiếu = chặn hết (403).
INTERNAL_API_TOKEN=

# --- RabbitMQ (container rabbitmq) ---
# Mật khẩu chỉ được áp dụng LÚC TẠO volume. Đổi về sau phải chạy thêm:
#   docker exec daln-prod-rabbitmq rabbitmqctl change_password <user> <pass>
# Chỉ dùng ký tự an toàn trong URL (chữ, số) vì nó được ghép vào RABBITMQ_URL.
RABBITMQ_DEFAULT_USER=daln
RABBITMQ_DEFAULT_PASS=

# --- MinIO (container minio) — cũng chính là khoá S3 của app ---
MINIO_ROOT_USER=daln-admin
# Tối thiểu 8 ký tự.
MINIO_ROOT_PASSWORD=
AWS_REGION=us-east-1
S3_BUCKET=daln-media
S3_ENDPOINT=http://minio:9000

# --- Hạ tầng nội bộ (tên service trong mạng docker) ---
REDIS_URL=redis://redis:6379
QDRANT_HOST=qdrant
QDRANT_PORT=6333
RECOMMENDATION_SERVICE_URL=http://recommendation:3005

# --- SMTP (Gmail: dùng App Password, không phải mật khẩu tài khoản) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Cuộc gọi: Cloudflare RealtimeKit ────────────────────────────────────────
# App "daln-prod" trong dashboard Cloudflare → Realtime → Kit. Token cần quyền
# Account · Realtime · Admin. Preset + webhook tạo bằng `npm run rtk:setup`
# (deploy/README.md, mục RealtimeKit). Thiếu một biến thì mọi cuộc gọi trả
# MEDIA_UNCONFIGURED.
REALTIMEKIT_ACCOUNT_ID=
REALTIMEKIT_APP_ID=
REALTIMEKIT_API_TOKEN=

# --- Gọi nội bộ giữa service ---
# Gateway hỏi chat service ai là người nhận hợp lệ của cuộc gọi 1-1 (call-peer).
# realtime-gateway nhận biến này qua env_file .env.production (docker-compose.prod.yml).
CHAT_SERVICE_URL=http://chat:3003
