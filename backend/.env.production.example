# ============================================================================
# Production — managed cloud infra (MongoDB Atlas, Amazon MQ, ElastiCache, Qdrant Cloud).
# Copy to .env.production và điền giá trị thật. KHÔNG commit file .env.production.
#
# Chạy app tier:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# ============================================================================

NODE_ENV=production

# --- MongoDB Atlas (mỗi microservice 1 database trên cùng cluster) ---
USER_DATABASE_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/user-service?retryWrites=true&w=majority
CHAT_DATABASE_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/chat-service?retryWrites=true&w=majority
NOTIFICATION_DATABASE_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/notification-service?retryWrites=true&w=majority
RECOMMENDATION_DATABASE_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/recommendation-service?retryWrites=true&w=majority
SAGA_DATABASE_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/saga-orchestrator-service?retryWrites=true&w=majority
USER_MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/user-service?retryWrites=true&w=majority

# --- RabbitMQ (Amazon MQ / CloudAMQP) ---
RABBITMQ_URL=amqps://USER:PASS@broker.example.com:5671

# --- Redis (ElastiCache / Upstash) — ưu tiên REDIS_URL ---
REDIS_URL=rediss://:PASSWORD@redis.example.com:6379
# Hoặc tách host/port (khi không dùng URL):
# REDIS_HOST=redis.example.com
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=true

# --- Qdrant Cloud ---
QDRANT_URL=https://xxxxxxxx.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# --- Neo4j: KHÔNG cần trên production runtime (chỉ training offline) ---

# --- Service URLs (Docker network trong app tier) ---
RECOMMENDATION_SERVICE_URL=http://recommendation:3005

# --- SMTP / S3 / secrets khác (copy từ .env dev nếu cần) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# AWS S3 (+ optional CloudFront later via CDN_PUBLIC_URL)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=daln-media-prod-435788423238-ap-southeast-1-an
# Without CloudFront: direct S3 URL (bucket must allow public GetObject)
CDN_PUBLIC_URL=https://daln-media-prod-435788423238-ap-southeast-1-an.s3.ap-southeast-1.amazonaws.com

# --- Kong CORS (frontend production) ---
KONG_CORS_ORIGINS=https://app.example.com

# --- Frontend deep links in transactional emails ---
FRONTEND_URL=https://nguyen1976.xyz

# --- Khoá ký JWT (BẮT BUỘC) ---
# Sinh bằng: openssl rand -hex 32
# Thiếu biến này thì dịch vụ sẽ dừng ngay khi khởi động thay vì chạy với khoá đoán được.
JWT_SECRET=
