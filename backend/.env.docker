# ============================================================================
# DEV ONLY — kết nối infra LOCAL trong docker compose.
# Production dùng .env.production + link managed cloud (xem .env.production.example).
# File này được nạp SAU .env nên ghi đè host -> tên service trong Docker network.
# ============================================================================

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# --- RabbitMQ (user/user khớp RABBITMQ_DEFAULT_USER/PASS) ---
RABBITMQ_URL=amqp://user:user@rabbitmq:5672

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- Service-to-service (Docker network) ---
RECOMMENDATION_SERVICE_URL=http://recommendation:3005

# --- Shared secret cho các endpoint @InternalOnly (train/evaluate/embed) ---
# DEV ONLY. Production phải sinh chuỗi ngẫu nhiên và đưa vào secret manager:
#   openssl rand -hex 32
INTERNAL_API_TOKEN=dev-internal-token-doi-o-production

# --- Hot-reload qua bind mount (cần bật polling trên macOS/Windows) ---
# WATCHPACK_POLLING: webpack (nest --watch) poll source TS.
# CHOKIDAR_USEPOLLING + CHOKIDAR_INTERVAL: nest-cli assets watcher (chokidar).
# BẮT BUỘC có CHOKIDAR_INTERVAL (số ms) -> nếu thiếu, chokidar v4 nhận
# interval=undefined và crash: ERR_INVALID_ARG_TYPE "interval" must be number.
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=1000

# --- MongoDB (Prisma) ---
# DATABASE_URL được set riêng từng service trong docker-compose.yml.
# Host: mongo:27017 | replica set: rs0 | volume: mongo_data
# Kết nối từ máy host (ngoài Docker): mongodb://localhost:27017/<db>?replicaSet=rs0

# --- SMTP (DEV) ---
# Trỏ về MailHog trong docker network: email không bao giờ rời máy local.
# Xem hộp thư: http://localhost:8025
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# --- Frontend base URL (dùng trong link của email) ---
FRONTEND_URL=http://localhost:5173

# --- Khoá ký JWT ---
# DEV ONLY. Production BẮT BUỘC đặt giá trị riêng (dịch vụ sẽ không khởi động
# nếu thiếu):  openssl rand -hex 32
JWT_SECRET=daln-dev-only-jwt-secret-doi-o-production
