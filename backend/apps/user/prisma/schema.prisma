generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  username  String   @unique
  fullName  String
  password  String
  isActive  Boolean  @default(false)
  avatar    String?
  bio       String?
  /// Interest tag slugs (e.g. "gaming") aligned with recommendation InterestTag.slug
  interests                        String[] @default([])
  /// After first onboarding selection; existing users without the field are treated as true in API responses
  hasCompletedInterestOnboarding   Boolean  @default(false)
  lastSeen DateTime?
  location Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Back sides of the relations below (Prisma needs both); not read directly.
  friendOf         Friendship[]    @relation("FriendshipFriend")
  sentRequests     friendRequest[] @relation("RequestFrom")
  receivedRequests friendRequest[] @relation("RequestTo")

  @@index([location], map: "location_2dsphere")
}

model Friendship {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  friendId  String   @db.ObjectId
  friend    User     @relation("FriendshipFriend", fields: [friendId], references: [id])
  createdAt DateTime @default(now())

  // Không có index nào ngoài _id thì mọi truy vấn bạn bè đều quét cả
  // collection (đo 2026-11-04: COLLSCAN). Thứ tự (userId, id) là thứ tự danh
  // sách bạn; (userId, friendId) phục vụ "hai người có là bạn"; friendId cho
  // chiều ngược lại. Chưa đặt unique: dữ liệu cũ có thể đã trùng cặp.
  @@index([userId, id])
  @@index([userId, friendId])
  @@index([friendId])
}

enum Status {
  PENDING
  REJECTED
  ACCEPTED
}

model friendRequest {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  fromUserId String   @db.ObjectId
  toUserId   String   @db.ObjectId
  fromUser   User     @relation("RequestFrom", fields: [fromUserId], references: [id])
  toUser     User     @relation("RequestTo", fields: [toUserId], references: [id])
  status     Status   @default(PENDING)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Danh sách lời mời đến / đi, mới nhất trước (findPending), và lời mời
  // đang chờ giữa hai người (findPendingBetweenUsers).
  @@index([toUserId, status, createdAt])
  @@index([fromUserId, status, createdAt])
}

enum OutboxStatus {
  NEW
  PUBLISHED
  FAILED
  DEAD
}

// Transactional Outbox: ghi cùng transaction với business write, relay publish sau.
model OutboxEvent {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  messageId     String       @unique
  exchange      String
  routingKey    String
  payload       Json
  status        OutboxStatus @default(NEW)
  attempt       Int          @default(0)
  maxAttempts   Int          @default(10)
  nextAttemptAt DateTime?
  publishedAt   DateTime?
  error         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, nextAttemptAt, createdAt])
}

// Inbox idempotency: messageId UNIQUE chặn xử lý trùng (race condition 100%).
model InboxMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  messageId String   @unique
  consumer  String
  sagaId    String?
  createdAt DateTime @default(now())

  @@index([sagaId])
}
