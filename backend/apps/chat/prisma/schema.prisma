generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum conversationType {
  DIRECT
  GROUP
}

enum participantRole {
  OWNER
  ADMIN
  MEMBER
}

enum messageType {
  TEXT
  IMAGE
  VIDEO
  FILE
  POLL
}

enum mediaType {
  IMAGE
  VIDEO
  FILE
}

model conversation {
  id                  String             @id @default(auto()) @map("_id") @db.ObjectId
  type                conversationType   @default(DIRECT)
  groupName           String?
  groupAvatar         String?
  memberCount         Int                @default(0)
  lastMessageText     String?
  lastMessageId       String?            @db.ObjectId
  lastMessageSenderId String?
  lastMessageSenderName String?
  lastMessageSenderAvatar String?
  members             conversationMember[]
  messages            message[]
  lastMessageAt       DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  groupNameSearch     String?


  @@index([type, groupNameSearch, updatedAt])
  @@index([lastMessageAt])
}

model conversationMember {
  id                String            @id @default(auto()) @map("_id") @db.ObjectId
  conversationId    String            @db.ObjectId
  userId            String            @db.ObjectId
  username          String?
  fullName          String?
  avatar            String?
  role              participantRole   @default(MEMBER)
  isActive          Boolean           @default(true)
  unreadCount       Int               @default(0)
  lastReadMessageId String?           @db.ObjectId
  lastReadAt        DateTime?
  clearedHistoryAt  DateTime?
  joinedAt          DateTime          @default(now())
  conversation      conversation      @relation(fields: [conversationId], references: [id])
  sentMessages      message[]         @relation("SenderMessages")
  lastMessageAt     DateTime?

  /// Phi chuẩn hoá "người đối diện" — CHỈ dùng cho hội thoại DIRECT.
  /// Danh sách hội thoại cần tên + avatar đối phương để hiển thị, nhưng
  /// `include: { members }` khiến truy vấn đắt tuyến tính theo số thành viên
  /// (đo được: 2 thành viên 1,56ms -> 500 thành viên 6,10ms, trong khi bỏ
  /// include thì phẳng 0,85ms). Vì "đối phương là ai" phụ thuộc người đang
  /// xem, dữ liệu này thuộc về dòng membership chứ không phải conversation.
  peerUserId        String?           @db.ObjectId
  peerUsername      String?
  peerFullName      String?
  peerAvatar        String?

  @@index([userId, isActive, lastMessageAt(sort: Desc)])
  
  @@unique([conversationId, userId])
  @@index([username])
  @@index([conversationId, lastReadAt])
}

model message {
  id              String             @id @default(auto()) @map("_id") @db.ObjectId
  conversationId  String             @db.ObjectId
  senderId        String             @db.ObjectId
  type            messageType        @default(TEXT)
  content         String?
  replyToMessageId String?           @db.ObjectId
  pollId          String?            @unique @db.ObjectId
  isRevoked       Boolean            @default(false)
  isDeleted       Boolean            @default(false)
  /// Tin nhắn do hệ thống ghi (thêm/xoá thành viên, kết cục cuộc gọi...).
  /// Không phải nội dung người dùng gõ, nên hiển thị khác và không có
  /// trạng thái đã xem.
  isSystem        Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  conversation    conversation       @relation(fields: [conversationId], references: [id])
  senderMember    conversationMember @relation("SenderMessages", fields: [conversationId, senderId], references: [conversationId, userId])
  replyTo         message?           @relation("MessageReply", fields: [replyToMessageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies         message[]          @relation("MessageReply")
  poll            poll?              @relation(fields: [pollId], references: [id])
  medias          messageMedia[]

  @@index([conversationId, createdAt, id])
}

type PollOption {
  id    String
  text  String
  count Int    @default(0)
}

model poll {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  question         String
  isMultipleChoice Boolean     @default(false)
  isClosed         Boolean     @default(false)
  closedAt         DateTime?
  options          PollOption[]
  message          message?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([isClosed, updatedAt])
}

model pollVote {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  pollId    String   @db.ObjectId
  userId    String   @db.ObjectId
  optionIds String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pollId, userId])
  @@index([pollId])
  @@index([userId, updatedAt])
}

model DeleteMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  messageId String   @db.ObjectId
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId, createdAt])
  @@index([messageId])
}

model messageMedia {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  messageId    String    @db.ObjectId
  mediaType    mediaType
  objectKey    String    @unique
  url          String
  mimeType     String
  size         BigInt
  width        Int?
  height       Int?
  duration     Float?
  thumbnailUrl String?
  fileName     String?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  message      message   @relation(fields: [messageId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([messageId, sortOrder])
}

enum OutboxStatus {
  NEW
  PUBLISHED
  FAILED
  DEAD
}

// Transactional Outbox: ghi cùng transaction với business write, relay publish sau.
model OutboxEvent {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  messageId     String       @unique
  exchange      String
  routingKey    String
  payload       Json
  status        OutboxStatus @default(NEW)
  attempt       Int          @default(0)
  maxAttempts   Int          @default(10)
  nextAttemptAt DateTime?
  publishedAt   DateTime?
  error         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, nextAttemptAt, createdAt])
}

// Inbox idempotency: messageId UNIQUE chặn xử lý trùng (race condition 100%).
model InboxMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  messageId String   @unique
  consumer  String
  sagaId    String?
  createdAt DateTime @default(now())

  @@index([sagaId])
}
